<Window x:Class="CopilotKnappen.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot Knappen – Settings"
        Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F8FA">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Padding="12">
            <!-- ============================================================ Custom commands -->
            <TabItem Header="Custom commands">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="Add" Click="Add_Click" />
                            <Button Content="Duplicate" Click="Duplicate_Click" />
                            <Button Content="Delete" Click="Delete_Click" />
                            <Button Content="▲" MinWidth="32" Padding="8,5" Click="MoveUp_Click" ToolTip="Move up" />
                            <Button Content="▼" MinWidth="32" Padding="8,5" Click="MoveDown_Click" ToolTip="Move down" />
                        </WrapPanel>
                        <ListBox x:Name="CommandList" SelectionChanged="CommandList_SelectionChanged"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,5">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" Margin="0,2,8,0"
                                                  VerticalAlignment="Top" ToolTip="Enabled" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Foreground="#FF6B7280" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="Editor">
                                    <TextBlock x:Name="NoSelection" Text="Select a command, or click Add to create one."
                                               Style="{StaticResource Hint}" Margin="0" />

                                    <StackPanel x:Name="EditorFields">
                                        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Text="Keywords" Style="{StaticResource Label}" />
                                        <TextBox x:Name="KeywordsBox" Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock x:Name="KeywordsHint" Style="{StaticResource Hint}" />

                                        <TextBlock Text="Match" Style="{StaticResource Label}" />
                                        <ComboBox x:Name="MatchCombo" SelectedItem="{Binding Match}" HorizontalAlignment="Left" MinWidth="220" />

                                        <TextBlock Text="Action" Style="{StaticResource Label}" />
                                        <ComboBox x:Name="ActionCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Type"
                                                  SelectedValue="{Binding Action}" HorizontalAlignment="Left" MinWidth="320" />

                                        <StackPanel x:Name="TargetPanel">
                                            <TextBlock x:Name="TargetLabel" Text="Target" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock x:Name="TargetHint" Style="{StaticResource Hint}" />
                                        </StackPanel>

                                        <StackPanel x:Name="ArgumentsPanel">
                                            <TextBlock x:Name="ArgumentsLabel" Text="Arguments" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock x:Name="ArgumentsHint" Style="{StaticResource Hint}" />
                                        </StackPanel>

                                        <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,14,0,0" />

                                        <Border Background="#FFF1F5FF" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                            <TextBlock Style="{StaticResource Hint}" Foreground="#FF374151" Margin="0">
                                                <Run FontWeight="SemiBold" Text="Placeholders" />
                                                <LineBreak />
                                                <Run Text="{}{query} – the text after the keyword (URL-encoded in “Open URL”)" />
                                                <LineBreak />
                                                <Run Text="{}{query:raw} – never encoded · {query:url} – always encoded · {input} – the whole prompt" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Try a prompt" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Text="See what the launcher would do with your unsaved changes." />
                                    <TextBox x:Name="TestBox" Margin="0,8,0,0" TextChanged="TestBox_TextChanged" />
                                    <TextBlock x:Name="TestResult" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================================================ General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GeneralPanel" MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Copilot key" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Style="{StaticResource Hint}">
                                    To open Copilot Knappen with the Copilot key, open Windows Settings → Personalization → Text input →
                                    “Customize Copilot key on keyboard” and choose Copilot Knappen. A single tap toggles the launcher;
                                    press and hold opens it.
                                </TextBlock>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Open Copilot key settings" Click="OpenCopilotKeySettings_Click" />
                                </WrapPanel>

                                <CheckBox x:Name="HotkeyCheck" Content="Also open with a keyboard shortcut" IsChecked="{Binding EnableHotkey}" Margin="0,16,0,0" />
                                <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" Margin="24,6,0,0" Width="220" HorizontalAlignment="Left"
                                         IsEnabled="{Binding IsChecked, ElementName=HotkeyCheck}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="24,3,0,0" Text="For example Ctrl+Alt+Space, Win+Shift+K or Ctrl+Shift+F12." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Behaviour" FontWeight="SemiBold" FontSize="15" />

                                <TextBlock Text="Search engine" Style="{StaticResource Label}" />
                                <ComboBox x:Name="SearchEngineCombo" IsEditable="True" Text="{Binding SearchUrlTemplate, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource Hint}" Text="Used when the prompt is a sentence. {query} is replaced by the URL-encoded prompt; your default browser is used." />

                                <TextBlock Text="Volume step (%)" Style="{StaticResource Label}" />
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="VolumeSlider" Minimum="1" Maximum="50" Width="260" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding VolumeStep}" />
                                    <TextBlock Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <CheckBox Content="Open applications when the prompt is an app name" IsChecked="{Binding DetectApplications}" />
                                <CheckBox Content="Use the Spotify desktop app for Spotify searches when it is installed" IsChecked="{Binding PreferSpotifyDesktop}" />
                                <CheckBox Content="Keep running in the background (tray icon) for instant start" IsChecked="{Binding KeepRunningInBackground}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Data" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="SettingsPathText" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="AppCountText" Style="{StaticResource Hint}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Open settings folder" Click="OpenSettingsFolder_Click" />
                                    <Button Content="Re-index applications" Click="Reindex_Click" />
                                    <Button Content="Restore default commands" Click="RestoreDefaults_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Built-in -->
            <TabItem Header="Built-in commands">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="These work out of the box. Custom commands are checked first, so a keyword you define overrides a built-in one." />
                        <ItemsControl x:Name="BuiltInList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Example}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Meaning}" TextWrapping="Wrap" Foreground="#FF374151" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" Margin="0" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FFB42318" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
