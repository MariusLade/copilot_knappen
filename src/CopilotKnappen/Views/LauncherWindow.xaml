<Window x:Class="CopilotKnappen.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot Knappen"
        Width="760"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="28" CornerRadius="16" Background="#F51C1D21" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="20,16,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InputIcon" Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                           FontSize="22" Foreground="#B0FFFFFF" VerticalAlignment="Center" Margin="2,0,14,0" />
                <TextBox x:Name="Input" Grid.Column="1" FontSize="26" FontFamily="Segoe UI Variable Display, Segoe UI"
                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         SelectionBrush="{StaticResource AccentBrush}" VerticalContentAlignment="Center"
                         Padding="0,2" TextChanged="Input_TextChanged" PreviewKeyDown="Input_PreviewKeyDown" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" IsHitTestVisible="False" FontSize="26"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#60FFFFFF" Margin="2,0,0,0"
                           VerticalAlignment="Center" Text="Search, open an app, play music…" />
            </Grid>

            <Border Height="1" Background="#26FFFFFF" Margin="0,14,0,10" />

            <DockPanel LastChildFill="True">
                <TextBlock x:Name="HintKeys" DockPanel.Dock="Right" Foreground="#80FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Text="Enter to run · Shift+Enter to search · Esc to close" />
                <TextBlock x:Name="PreviewIcon" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,10,0" Text="&#xE946;" />
                <TextBlock x:Name="PreviewText" Foreground="#E6FFFFFF" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           Text="Try “play daft punk”, “volume 30”, “youtube cats”, “notepad” or “settings”" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
